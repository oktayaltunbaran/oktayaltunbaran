# =====================================================================
#  Termux Margin Long/Short Bot — yapilandirma
#  Bu dosyayi .env olarak kopyalayin:  cp .env.example .env && chmod 600 .env
#  .env ASLA git'e eklenmez, kimseyle paylasilmaz.
# =====================================================================

# ---------- Telegram ----------
# BotFather'dan: /newbot -> token
TELEGRAM_BOT_TOKEN=
# Kendi sohbet id'niz (ozel sohbet). Bilmiyorsaniz: .venv/bin/python -m bot chatid
TELEGRAM_CHAT_ID=

# ---------- Calisma modu ----------
# paper : gercek fiyatlarla simulasyon (VARSAYILAN, en az 2-4 hafta boyle kullanin)
# live  : gercek emir (USE_TESTNET=true ile once demo hesapta deneyin)
MODE=paper
# false: her sinyal Telegram'da "Ac / Gec" onayi ister (onerilen)
# true : sinyaller onaysiz uygulanir (Telegram'dan /oto ac | /oto kapat ile de degisir)
AUTO_TRADE=false
# Emirlerin gidecegi borsa: binance | bybit | okx
EXEC_EXCHANGE=binance
# Veri (spot + perp + funding + OI) toplanacak borsalar. Bolgenizde erisilemeyen
# bir borsayi buradan cikarin (en az 2 borsa; EXEC_EXCHANGE dahil olmali).
DATA_EXCHANGES=binance,bybit,okx
# Demo/testnet: Binance & Bybit "demo trading", OKX "demo trading" anahtarlari gerekir
USE_TESTNET=false

SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=2h
# Mum kapanisindan kac saniye sonra analiz (borsalarin mumu kesinlestirmesi icin)
CANDLE_CLOSE_DELAY_SEC=20
# Onayli modda sinyalin gecerlilik suresi (dakika)
CONFIRM_TIMEOUT_MIN=15
# true: her 2 saatte bir kisa (sessiz) piyasa ozeti gonder
CYCLE_REPORT=false

# ---------- Sermaye ve risk ----------
# Islem basina ayrilan marjin ve kaldirac -> max nominal = 30 x 5 = 150 USDT
MARGIN_USDT=30
LEVERAGE=5
# Stop calisirsa kaybedilecek TUTAR (komisyon + kayma dahil). Pozisyon buyuklugu
# buna gore hesaplanir; 150 USDT tavanini asamaz. 1.5 USDT = 30 USDT'nin %5'i.
RISK_PER_TRADE_USDT=1.5
# UTC gun icinde bu kadar zarar edilirse ertesi gune kadar yeni islem yok
MAX_DAILY_LOSS_USDT=4.5
# Ust uste bu kadar kayipta bot kendini duraklatir (/devam ile acilir)
MAX_CONSECUTIVE_LOSSES=3
# Bakiye bunun altina duserse islem acilmaz
MIN_EQUITY_USDT=20
PAPER_START_EQUITY=30
# true: pozisyon izole marjinde degilse aninda kapatilir
REQUIRE_ISOLATED=true
# Tek yon taker komisyon (muhafazakar: 0.0006 = %0.06) ve kayma (%)
FEE_RATE=0.0006
SLIPPAGE_PCT=0.05

# ---------- Strateji (2s trend + pullback) ----------
EMA_FAST=21
EMA_MID=50
EMA_SLOW=200
ADX_MIN=20
RSI_LONG_MIN=45
RSI_LONG_MAX=70
RSI_SHORT_MIN=30
RSI_SHORT_MAX=55
# Stop = 1.5 x ATR(14); %0.4'ten dar olamaz, %4'ten genis ise islem yapilmaz
ATR_SL_MULT=1.5
MIN_SL_PCT=0.4
MAX_SL_PCT=4.0
# Hedef = 2R ; fiyat 1R lehte gidince stop basabase (komisyon dahil) tasinir (0=kapali)
TP_R_MULT=2.0
BREAKEVEN_AT_R=1.0
# Bu kadar mum (24 x 2s = 48 saat) icinde SL/TP olmazsa pozisyon kapatilir (0=kapali)
MAX_HOLD_CANDLES=24
# Turev filtreleri: funding 8 saatlik esdeger (0.0005 = %0.05)
FUNDING_LIMIT=0.0005
MAX_PRICE_DIVERGENCE_PCT=0.5
MAX_BASIS_PCT=0.5

# ---------- Izleme ----------
MONITOR_INTERVAL_SEC=30

# ---------- Borsa API anahtarlari (yalnizca MODE=live icin) ----------
# Izinler: SADECE okuma + vadeli islem (Futures/Derivatives Trade).
# PARA CEKME (Withdraw) iznini ASLA acmayin.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSWORD=
