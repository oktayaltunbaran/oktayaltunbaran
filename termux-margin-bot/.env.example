# =====================================================================
#  Termux Margin Long/Short Bot — yapilandirma
#  Bu dosyayi .env olarak kopyalayin:  cp .env.example .env && chmod 600 .env
#  .env ASLA git'e eklenmez, kimseyle paylasilmaz.
# =====================================================================

# ---------- Telegram ----------
# BotFather'dan: /newbot -> token
TELEGRAM_BOT_TOKEN=
# Kendi sohbet id'niz (ozel sohbet). Bilmiyorsaniz: .venv/bin/python -m bot chatid
TELEGRAM_CHAT_ID=

# ---------- Calisma modu ----------
# paper : gercek fiyatlarla simulasyon (VARSAYILAN, en az 2-4 hafta boyle kullanin)
# live  : gercek emir (USE_TESTNET=true ile once demo hesapta deneyin)
MODE=paper
# false: her sinyal Telegram'da "Ac / Gec" onayi ister (onerilen)
# true : sinyaller onaysiz uygulanir (Telegram'dan /oto ac | /oto kapat ile de degisir)
AUTO_TRADE=false
# Emirlerin gidecegi borsa: binance | bybit | okx
EXEC_EXCHANGE=binance
# Veri (spot + perp + funding + OI) toplanacak borsalar. Bolgenizde erisilemeyen
# bir borsayi buradan cikarin (en az 2 borsa; EXEC_EXCHANGE dahil olmali).
DATA_EXCHANGES=binance,bybit,okx
# Demo/testnet: Binance & Bybit "demo trading", OKX "demo trading" anahtarlari gerekir
USE_TESTNET=false

# BTC bu sermayede islem goremez (Binance asgari pozisyon 100 USDT); analiz icin eklenebilir.
SYMBOLS=ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT,DOGE/USDT,ADA/USDT,AVAX/USDT,LINK/USDT,LTC/USDT
TIMEFRAME=2h
# Mum kapanisindan kac saniye sonra analiz (borsalarin mumu kesinlestirmesi icin)
CANDLE_CLOSE_DELAY_SEC=20
# Onayli modda sinyalin gecerlilik suresi (dakika)
CONFIRM_TIMEOUT_MIN=15
# true: her 2 saatte bir kisa (sessiz) piyasa ozeti gonder
CYCLE_REPORT=false

# ---------- Sermaye ve risk ----------
# RISK_MODE=fixed (kullanici semasi, VARSAYILAN):
#   her islem FIXED_MARGIN_USDT x LEVERAGE nominal (30 x 5 = 150 USDT),
#   stop: NET zarar SL_LOSS_USDT (komisyon+kayma dahil, tam 2.5$),
#   hedef: NET kar en az marjinin TP_ROI_PCT'si (%25 = 7.5$).
#   UYARI: 4 yillik testte bu sema islem basina -0.09R zarar etti (README). Paper modda izleyin.
# RISK_MODE=risk: pozisyon buyuklugu stop mesafesinden; stopta RISK_PER_TRADE_USDT kaybedilir
#   (test edilen ve karli cikan Supertrend iz suren cikisi ile birlikte kullanilir).
RISK_MODE=fixed
FIXED_MARGIN_USDT=30
TP_ROI_PCT=25
SL_LOSS_USDT=2.5
MARGIN_USDT=30
LEVERAGE=5
# (yalnizca RISK_MODE=risk) stopta kaybedilecek tutar
RISK_PER_TRADE_USDT=1.0
# Ayni anda en fazla kac pozisyon (fixed modda 30$ hesapla pratikte 1)
MAX_OPEN_POSITIONS=1
# UTC gun icinde bu kadar zarar edilirse ertesi gune kadar yeni islem yok
MAX_DAILY_LOSS_USDT=5.0
# Ust uste bu kadar kayipta bot kendini duraklatir (/devam ile acilir).
# Trend stratejisinde isabet ~%35'tir; 3-5 kayip serisi normaldir.
MAX_CONSECUTIVE_LOSSES=6
# Bakiye bunun altina duserse islem acilmaz
MIN_EQUITY_USDT=20
PAPER_START_EQUITY=30
# true: pozisyon izole marjinde degilse aninda kapatilir
REQUIRE_ISOLATED=true
# Tek yon taker komisyon (muhafazakar: 0.0006 = %0.06) ve kayma (%)
FEE_RATE=0.0006
SLIPPAGE_PCT=0.05

# ---------- Strateji ----------
# supertrend: 4 yillik 10 coin testinde secilen strateji (VARSAYILAN)
#   giris: Supertrend(10,3) yon degistirdigi 2s kapanista, EMA200 ile ayni yonde
#   stop : borsada, Supertrend cizgisi -/+ 1 ATR; her 2s kapanista lehte tasinir
#   cikis: 2s mum Supertrend'in ters tarafinda kapaninca (sabit hedef yok)
# pullback: eski strateji (testte zararda; yalnizca karsilastirma icin)
STRATEGY=supertrend
ST_LEN=10
ST_MULT=3.0
ST_STOP_ATR=1.0

# --- asagidakiler pullback stratejisi icindir (EMA200 her ikisinde kullanilir) ---
EMA_FAST=21
EMA_MID=50
EMA_SLOW=200
ADX_MIN=20
RSI_LONG_MIN=45
RSI_LONG_MAX=70
RSI_SHORT_MIN=30
RSI_SHORT_MAX=55
# Stop %0.4'ten dar olamaz; %6'dan genis ise islem yapilmaz (her iki strateji)
ATR_SL_MULT=1.5
MIN_SL_PCT=0.4
MAX_SL_PCT=6.0
# Hedef = 2R ; fiyat 1R lehte gidince stop basabase (komisyon dahil) tasinir (0=kapali)
TP_R_MULT=2.0
BREAKEVEN_AT_R=1.0
# Bu kadar mum (24 x 2s = 48 saat) icinde SL/TP olmazsa pozisyon kapatilir (0=kapali)
MAX_HOLD_CANDLES=24
# Turev filtreleri: funding 8 saatlik esdeger (0.0005 = %0.05)
FUNDING_LIMIT=0.0005
MAX_PRICE_DIVERGENCE_PCT=0.5
MAX_BASIS_PCT=0.5

# ---------- Izleme ----------
MONITOR_INTERVAL_SEC=30

# ---------- Borsa API anahtarlari (yalnizca MODE=live icin) ----------
# Izinler: SADECE okuma + vadeli islem (Futures/Derivatives Trade).
# PARA CEKME (Withdraw) iznini ASLA acmayin.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSWORD=
